# 백엔드 추가 환경 변수 예시. 쓸 때는 .env 로 복사한다. (Git 추적 제외)
# local 프로필은 infrastructure/.env 와 이 파일을 함께 읽는다.
# DB 접속 정보(DB_PASSWORD, DB_PORT)는 infrastructure/.env 에 있으므로 여기 다시 적지 않는다.
# 필요할 때만 덮어쓴다: DB_HOST=127.0.0.1, DB_NAME=securelab, DB_USERNAME=securelab

# Redis (4주차)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 로그인 기록 email_digest 용 HMAC 키 (4주차, 무작위 값)
LOGIN_DIGEST_SECRET=

# AI (5~6주차): mock | ollama
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
