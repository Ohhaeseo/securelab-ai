# 백엔드 실행용 환경 변수 예시.
# 실제 값은 .env 또는 OS 환경 변수에 두고 커밋하지 않는다.

SPRING_PROFILES_ACTIVE=local

# PostgreSQL (포트·비밀번호는 infrastructure/.env 의 DB_PORT·DB_PASSWORD 와 같게)
DB_URL=jdbc:postgresql://127.0.0.1:5432/securelab
DB_USERNAME=securelab
DB_PASSWORD=

# Redis (4주차)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 로그인 기록 email_digest 용 HMAC 키 (4주차, 무작위 값)
LOGIN_DIGEST_SECRET=

# AI (5~6주차): mock | ollama
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
