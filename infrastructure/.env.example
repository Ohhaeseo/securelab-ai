# docker compose 용. infrastructure/.env 로 복사한 뒤 값을 채운다. (Git 추적 제외)
# 백엔드 local 프로필도 이 파일을 읽어 DB에 접속하므로, 값은 여기에만 적는다.
DB_PASSWORD=

# 호스트 포트 (기본 5432). 로컬에 PostgreSQL이 이미 설치돼 있으면 예: 55432
DB_PORT=5432

# Redis (4주차). 무작위 값을 쓴다. 백엔드 local 프로필도 이 값을 읽는다.
REDIS_PASSWORD=
REDIS_PORT=6379

# 로그인 기록의 이메일 다이제스트(HMAC) 키. 무작위 값. 비우면 앱이 실행할 때마다 임시 키를 만든다.
LOGIN_DIGEST_SECRET=
